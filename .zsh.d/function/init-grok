#!/usr/bin/env zsh
echo
echo '[init-grok]'
_start_time=$(date +"%s.%3N")

# ----------------------------------------------------------------------
# ### Grok CLI (Grok Build) ###
# xAI's official terminal coding agent.
# Sign in with your X / SuperGrok account:
#   grok login               # browser (loopback) OAuth
#   grok login --device-auth # device-code flow for headless/remote/WSL
# Or fall back to an API key: export XAI_API_KEY="xai-..."
get-grok() {
  case "${OSTYPE}" in
    freebsd* | darwin* | linux*)
      npm install -g @xai-official/grok
      exec -l zsh
      ;;
  esac
}
if ! type -p grok >/dev/null; then get-grok; fi

# Grok matches the terminal's background color on startup, so it goes dark on a
# dark terminal. Force the light theme (macOS Basic) on the bare TUI launch only;
# `--light` is rejected alongside subcommands (e.g. `grok login`), so pass through
# any invocation that has arguments unchanged.
grok() {
  if [ "$#" -eq 0 ]; then
    command grok --light
  else
    command grok "$@"
  fi
}

_end_time=$(date +"%s.%3N")
echo time: $(echo "$_end_time - $_start_time" | bc) sec
