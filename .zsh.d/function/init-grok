#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-grok]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

# ----------------------------------------------------------------------
# ### Grok CLI (Grok Build) ###
# xAI's official terminal coding agent.
# Sign in with your X / SuperGrok account:
#   grok login               # browser (loopback) OAuth
#   grok login --device-auth # device-code flow for headless/remote/WSL
# Or fall back to an API key: export XAI_API_KEY="xai-..."
# Native installations keep the executable outside npm's global bin directory.
if [[ -x "$HOME/.grok/bin/grok" && ${path[(Ie)$HOME/.grok/bin]} -eq 0 ]]; then
  export PATH="$HOME/.grok/bin:$PATH"
fi

get-grok() {
  case "${OSTYPE}" in
    freebsd* | darwin* | linux*)
      if ! npm install -g @xai-official/grok; then
        print -u2 '[init-grok] Installation failed; continuing shell initialization. Retry with get-grok.'
        return 1
      fi
      if type -p nodenv >/dev/null; then nodenv rehash; fi
      rehash
      if ! type -p grok >/dev/null; then
        print -u2 '[init-grok] grok is still missing from PATH; check the npm global bin directory.'
        return 1
      fi
      ;;
  esac
}
if ! type -p grok >/dev/null; then get-grok; fi

# Readability is handled by ~/.grok/config.toml (screen_mode = "minimal"), which
# renders in the terminal's own palette, so no --light wrapper is needed here.

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
