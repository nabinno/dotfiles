#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-ansible]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

get-ansible() {
  pip install \
    ansible \
    apache-libcloud
  mkdir -p ~/.gcp
}
if ! type -p ansible-playbook >/dev/null; then get-ansible; fi

# ----------------------------------------------------------------------
# ### ans (ansible wrapper) ###
get-ans() {
  case "${OSTYPE}" in
    freebsd* | darwin* | linux*)
      git clone https://github.com/nabinno/ans ~/.ans
      eval "$(ans init -)"
      ;;
  esac
}
if ! type -p ans >/dev/null; then get-ans; fi
if type -p ans >/dev/null; then source "$(zsh-cache ans-init.zsh ans init -)"; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
