#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-csv]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

# ----------------------------------------------------------------------
# ### installation ###
get-trdsql() {
  case "${OSTYPE}" in
    darwin*) brew install noborus/tap/trdsql ;;
    linux*) brew install noborus/tap/trdsql ;;
  esac
}
if ! type -p trdsql >/dev/null; then get-trdsql; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
