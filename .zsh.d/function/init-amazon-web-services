#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-amazon-web-services]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

export SAM_CLI_TELEMETRY=0

get-aws() {
  case "${OSTYPE}" in
    freebsd*) ;;
    darwin*) (
      local temp_dir
      temp_dir=$(mktemp -d) || return
      trap 'rm -rf "$temp_dir"' EXIT
      mkdir -p "$HOME/.local/bin" || return
      if [[ ! -x "$HOME/.local/aws-cli/aws" ]]; then
        python3 - "$temp_dir/choices.xml" "$HOME/.local" <<'PYTHON'
import plistlib
import sys

with open(sys.argv[1], "wb") as choices:
    plistlib.dump([{
        "choiceAttribute": "customLocation",
        "attributeSetting": sys.argv[2],
        "choiceIdentifier": "default",
    }], choices)
PYTHON
        curl -fsSL https://awscli.amazonaws.com/AWSCLIV2.pkg -o "$temp_dir/AWSCLIV2.pkg" &&
          /usr/sbin/installer -pkg "$temp_dir/AWSCLIV2.pkg" -target CurrentUserHomeDirectory -applyChoiceChangesXML "$temp_dir/choices.xml" || return
      fi
      [[ -e "$HOME/.local/bin/aws" ]] || ln -s "$HOME/.local/aws-cli/aws" "$HOME/.local/bin/aws"
      [[ -e "$HOME/.local/bin/aws_completer" ]] || ln -s "$HOME/.local/aws-cli/aws_completer" "$HOME/.local/bin/aws_completer"
      ) ;;
    linux*)
      (
        cd ~
        curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
        unzip awscliv2.zip
        sudo ./aws/install
        rm -fr awscliv2.zip
      )
      case "${DIST}" in
        RedHat | redhat)
          curl "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/linux_64bit/session-manager-plugin.rpm" -o "session-manager-plugin.rpm"
          sudo yum install -y session-manager-plugin.rpm
          ;;
        Ubuntu)
          curl "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb" -o "session-manager-plugin.deb"
          sudo dpkg -i session-manager-plugin.deb
          ;;
      esac
      ;;
  esac
}
if ! type -p aws >/dev/null; then get-aws; fi

get-awslogs() {
  case "${OSTYPE}" in
    freebsd*) ;;
    darwin*) uv tool install awslogs ;;
    linux*)
      pip install -U awslogs
      ;;
  esac
}
if ! type -p awslogs >/dev/null; then get-awslogs; fi

get-ecs-cli() {
  if ! type -p pip >/dev/null; then get-pip; fi
  case "${OSTYPE}" in
    freebsd*) ;;
    darwin*)
      sudo curl -o /usr/local/bin/ecs-cli https://amazon-ecs-cli.s3.amazonaws.com/ecs-cli-darwin-amd64-latest
      ;;
    linux*)
      sudo curl -o /usr/local/bin/ecs-cli https://amazon-ecs-cli.s3.amazonaws.com/ecs-cli-linux-amd64-latest
      ;;
  esac
}
# if ! type -p ecs-cli >/dev/null; then get-ecs-cli; fi

get-aws2-wrap() {
  case "$OSTYPE" in
    darwin*) uv tool install aws2-wrap==1.1.9 ;;
    *) pip3 install aws2-wrap==1.1.9 ;;
  esac
}
if ! type -p aws2-wrap >/dev/null; then get-aws2-wrap; fi

get-aws-cdk() {
  npm i -g aws-cdk || return
  if type -p nodenv >/dev/null; then nodenv rehash; fi
}
if ! type -p cdk >/dev/null; then get-aws-cdk; fi

get-aws-sam() {
  case "${OSTYPE}" in
    darwin* | linux*)
      brew tap aws/tap
      brew install aws-sam-cli
      ;;
  esac
}
# if ! type -p sam >/dev/null; then get-aws-sam; fi

if [[ $OSTYPE == darwin* && "$(command -v ruby)" == /usr/bin/ruby ]]; then
  path=("$(ruby -e 'print Gem.user_dir')/bin" $path)
fi

get-aws-rails-provisioner() {
  # Check if Ruby has OpenSSL support before attempting gem install
  if ruby -ropenssl -e 'puts OpenSSL::OPENSSL_VERSION' >/dev/null 2>&1; then
    case "${OSTYPE}" in
      linux*)
        case "${DIST}" in
          Ubuntu) sudo apt install gnupg2 pass ;;
        esac
        ;;
    esac
    if [[ $OSTYPE == darwin* && "$(command -v ruby)" == /usr/bin/ruby ]]; then
      gem install --user-install aws-rails-provisioner --pre
    else
      gem install aws-rails-provisioner --pre
    fi
  else
    echo "Warning: Ruby OpenSSL support unavailable. Skipping aws-rails-provisioner installation."
    echo "Run 'rbenv install 3.1.0 --force' to rebuild Ruby with current OpenSSL."
  fi
}
if ! type -p aws-rails-provisioner >/dev/null; then get-aws-rails-provisioner; fi

fix-compdef-problem() {
  touch ~/.zshenv
  echo 'autoload -Uz compinit
compinit' >>~/.zshenv
}

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
