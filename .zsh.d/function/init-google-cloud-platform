#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-google-cloud-platform]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

# #
# # CHEATSHEET
# #
# # 1. Initialize
# gcloud init
#
# # 2. Login
# gcloud auth login
#
# # 3. Setup project_id
# gcloud config set project $project_id
#
# GCLOUD_PROJECT_ID=$project_id
PATH="$HOME/google-cloud-sdk/bin:$PATH"
if [[ $OSTYPE != darwin* ]] && (( $+commands[python] )); then
  export CLOUDSDK_PYTHON=$commands[python]
fi

get-gcloud() {
  case "${OSTYPE}" in
    darwin*) (
      local archive_arch temp_dir
      case "$(uname -m)" in
        arm64) archive_arch=arm ;;
        x86_64) archive_arch=x86_64 ;;
        *) return 1 ;;
      esac
      [[ ! -e "$HOME/google-cloud-sdk" ]] || return 1
      temp_dir=$(mktemp -d) || return
      trap 'rm -rf "$temp_dir"' EXIT
      curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-darwin-${archive_arch}.tar.gz" -o "$temp_dir/sdk.tar.gz" &&
        tar -xzf "$temp_dir/sdk.tar.gz" -C "$temp_dir" &&
        mv "$temp_dir/google-cloud-sdk" "$HOME/google-cloud-sdk"
      ) ;;
    cygwin | linux*)
      curl https://sdk.cloud.google.com | bash
      exec -l $SHELL
      ;;
  esac
}

set-gcloud() {
  case "${OSTYPE}" in
    cygwin | darwin* | linux*)
      [[ ! -r ~/google-cloud-sdk/completion.zsh.inc ]] || source ~/google-cloud-sdk/completion.zsh.inc
      [[ ! -r ~/google-cloud-sdk/path.zsh.inc ]] || source ~/google-cloud-sdk/path.zsh.inc
      [ -n "$GCLOUD_PROJECT_ID" ] && gcloud config set project $GCLOUD_PROJECT_ID
      ;;
  esac
}

gcloud-init() {
  gcloud init
}

if ! type -p gcloud >/dev/null; then get-gcloud; fi
if [[ $OSTYPE == darwin* && -x "$HOME/google-cloud-sdk/bin/gcloud" && -z ${CLOUDSDK_PYTHON:-} ]] && (( $+commands[uv] )); then
  if uv python install 3.12 --quiet; then
    export CLOUDSDK_PYTHON="$(uv python find --managed-python 3.12)"
  fi
fi
if type -p gcloud >/dev/null; then set-gcloud; fi

# ----------------------------------------------------------------------
# GoogleCloudPubsub
gcloud-pubsub-init() {
  eval $(gcloud beta emulators pubsub env-init)
}

gcloud-pubsub-status() {
  echo $PUBSUB_EMULATOR_HOST
  ps aux | grep [p]ubsub
}

gcloud-pubsub-start() {
  nohup gcloud beta emulators pubsub start >~/.config/gcloud/logs/gcloud-pubsub.log 2>&1 &
  gcloud-pubsub-init
  gcloud-pubsub-status
}

gcloud-pubsub-stop() {
  for i in $(ps aux | grep [p]ubsub | awk '{print $2}'); do
    if [ $i -gt 0 ]; then
      sudo kill -9 $i
    fi
  done
}

gcloud-pubsub-restart() {
  gcloud-pubsub-stop
  gcloud-pubsub-start
}

gcloud-pubsub-log() {
  tailf ~/.config/gcloud/logs/gcloud-pubsub.log
}

alias gcpt=gcloud-pubsub-stop
alias gcpk=gcloud-pubsub-stop
alias gcpr=gcloud-pubsub-restart
alias gcpl=gcloud-pubsub-log
alias gcps=gcloud-pubsub-status
alias gcpp=gcloud-pubsub-status

# ----------------------------------------------------------------------
# Firebase
get-firebase-tools() {
  npm install -g firebase-tools || return
  if type -p nodenv >/dev/null; then nodenv rehash; fi
}
if ! type -p firebase >/dev/null; then get-firebase-tools; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
