#!/usr/bin/env zsh
echo
echo '[init-herdr]'
_start_time=$(date +"%s.%3N")

get-herdr() {
  case "${OSTYPE}" in
    darwin*) brew install herdr ;;
    linux*)
      if type -p brew >/dev/null; then
        brew install herdr
      else
        curl -fsSL https://herdr.dev/install.sh | sh
      fi
      ;;
  esac
}

if ! type -p herdr >/dev/null; then get-herdr; fi

_end_time=$(date +"%s.%3N")
echo time: $(echo "$_end_time - $_start_time" | bc) sec
