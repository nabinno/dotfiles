#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-herdr]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

get-herdr() {
  case "${OSTYPE}" in
    darwin*) brew install herdr ;;
    linux*)
      if type -p brew >/dev/null; then
        brew install herdr
      else
        curl -fsSL https://herdr.dev/install.sh | sh
      fi
      ;;
  esac
}

if ! type -p herdr >/dev/null; then get-herdr; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
