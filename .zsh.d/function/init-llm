# ----------------------------------------------------------------------
# ### Antigravity CLI ###
# The official installer places agy here. Make it available in this shell too.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

get-antigravity() (
  case "${OSTYPE}" in
    darwin* | linux*)
      local installer
      installer=$(mktemp) || return 1
      trap 'rm -f "$installer"' EXIT
      curl -fsSL https://antigravity.google/cli/install.sh -o "$installer" || return 1
      bash "$installer"
      ;;
  esac
)
if ! type -p agy >/dev/null; then get-antigravity; fi

# ----------------------------------------------------------------------
# ### codex ###
get-codex() {
  case "${OSTYPE}" in
    freebsd* | darwin* | linux*)
      npm install -g @openai/codex
      type -p nodenv >/dev/null && nodenv rehash
      exec -l zsh
      ;;
  esac
}
if ! type -p codex >/dev/null; then get-codex; fi

# Use a fresh server and allow workspace edits with approval when needed.
alias codex='codex --no-daemon --sandbox workspace-write --ask-for-approval on-request'

# ----------------------------------------------------------------------
# ### Q CLI ###
get-qcli() {
  case "${OSTYPE}" in
    linux*)
      case "${DIST}" in
        Ubuntu)
          wget https://desktop-release.q.us-east-1.amazonaws.com/latest/amazon-q.deb
          sudo apt-get install -f
          sudo dpkg -i amazon-q.deb
          ;;
      esac
      ;;
  esac
}
if ! type -p q >/dev/null && sudo -n true 2>/dev/null; then get-qcli; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
