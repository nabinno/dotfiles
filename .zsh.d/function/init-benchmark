#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-benchmark]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

# Install optional benchmark tools explicitly with get-ab, get-wrk, or
# get-phoronix-test-suite; shell startup must not download packages.

# Ab
function get-ab() {
  case "${OSTYPE}" in
    freebsd* | darwin*) ;;
    linux*)
      case "${DIST}" in
        Redhat | RedHat) sudo yum install -y httpd-tools ;;
        Debian | Ubuntu) sudo apt-get install -y apache2-utils ;;
      esac
      ;;
  esac
}

# ----------------------------------------------------------------------
# Wrk
function get-wrk() {
  case "${OSTYPE}" in
    freebsd*) ;;
    darwin*) brew install wrk ;;
    linux*)
      case "${DIST}" in
        Redhat | RedHat)
          cd ~
          sudo yum groupinstall 'Development Tools'
          sudo yum install openssl-devel
          git clone https://github.com/wg/wrk.git
          cd wrk && make && cp wrk ~/.local/bin
          cd ~ && rm -fr wrk
          ;;
        Debian | Ubuntu) brew install wrk ;;
      esac
      ;;
  esac
}

# ----------------------------------------------------------------------
# Phoronix Test Suite
function get-phoronix-test-suite() {
  case "${OSTYPE}" in
    freebsd* | darwin*) ;;
    linux*)
      brew install phoronix-test-suite
      case "${DIST}" in
        Redhat | RedHat) sudo yum install php-gd php-xml php-curl ;;
        Ubuntu) sudo apt install php-gd php-xml php-curl ;;
      esac
      ;;
  esac
}

# ----------------------------------------------------------------------
# curlb
curlb() {
  local num=$1
  shift
  for _i in {0..$num}; do
    curl $* -s -w '%{time_total}\n' -o /dev/null
  done >&2 | awk '{t+=$0}END{print "AVG: " t/NR}'
}

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
