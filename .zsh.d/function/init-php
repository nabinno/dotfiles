#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-php]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

export REQUIRED_PHP_VERSION=7.2.19

# ### version control ###
get-phpenv() {
  case "${OSTYPE}" in
    darwin*)
      anyenv install phpenv || return
      export PHPENV_ROOT="${ANYENV_ROOT:-$HOME/.anyenv}/envs/phpenv"
      path=("$PHPENV_ROOT/bin" "$PHPENV_ROOT/shims" $path)
      ;;
    freebsd* | linux*) anyenv install phpenv && exec -l zsh ;;
  esac
}

# ----------------------------------------------------------------------
# ### installation ###
get-php() {
  case "${OSTYPE}" in
    darwin*) (
      local archive_arch binary
      case "$(uname -m)" in
        arm64) archive_arch=arm64 ;;
        x86_64) archive_arch=x64 ;;
        *) return 1 ;;
      esac
      mkdir -p "$HOME/.local/bin" || return
      binary=$(mktemp "$HOME/.local/bin/.php.XXXXXX") || return
      trap 'rm -f "$binary"' EXIT
      # php.new publishes a self-contained macOS CLI with common extensions.
      curl -fsSL "https://download.herdphp.com/herd-lite/macos/$archive_arch/8.5/php" -o "$binary" &&
        chmod 755 "$binary" &&
        /usr/bin/codesign --verify --strict "$binary" &&
        "$binary" -n -v >/dev/null &&
        mv -n "$binary" "$HOME/.local/bin/php"
      ) ;;
    freebsd*) nix-install php-with-extensions ;;
    linux*)
      case $DIST_VERSION in
        14.04) sudo apt-get install -y php-$REQUIRED_PHP_VERSION ;;
        16.04 | 18.04 | 20.04 | 22.04) sudo apt install -y php ;;
        *) nix-install php-with-extensions ;;
      esac
      ;;
  esac
}
if ! type -p php >/dev/null; then get-php; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
