#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-ruby]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

export REQUIRED_RUBY_VERSION=3.1.0
export RUBY_PACKAGE_MANAGER=anyenv

# ### version control ###
get-rbenv() {
  case "${OSTYPE}" in
    darwin*)
      anyenv install rbenv || return
      export RBENV_ROOT="${ANYENV_ROOT:-$HOME/.anyenv}/envs/rbenv"
      path=("$RBENV_ROOT/bin" "$RBENV_ROOT/shims" $path)
      git clone https://github.com/amatsuda/gem-src.git "$RBENV_ROOT/plugins/gem-src"
      ;;
    freebsd* | linux*)
      anyenv install rbenv
      git clone https://github.com/amatsuda/gem-src.git "$(rbenv root)"/plugins/gem-src
      exec -l zsh
      ;;
  esac
}

# ----------------------------------------------------------------------
# ### installation ###
get-ruby() {
  eval "get-ruby-by-${RUBY_PACKAGE_MANAGER}"
  (get-global-gem-packages 2 &)
}

get-ruby-by-asdf() {
  case "${OSTYPE}" in
    cygwin) apt-cyg install ruby ;;
    freebsd* | darwin* | linux*)
      case $(asdf plugin list) in *ruby*) ;; *) asdf plugin add ruby ;; esac
      asdf install ruby $REQUIRED_RUBY_VERSION
      asdf set ruby $REQUIRED_RUBY_VERSION
      ;;
  esac
}

get-ruby-by-anyenv() {
  case "${OSTYPE}" in
    cygwin) apt-cyg install ruby ;;
    darwin*)
      type -p rbenv >/dev/null || get-rbenv || return
      local openssl_prefix libyaml_prefix
      openssl_prefix=$(brew --prefix openssl@3)
      libyaml_prefix=$(brew --prefix libyaml)
      [[ -r "$openssl_prefix/include/openssl/ssl.h" ]] || brew install openssl@3 || return
      [[ -r "$libyaml_prefix/include/yaml.h" ]] || brew install libyaml || return
      RUBY_CONFIGURE_OPTS="${RUBY_CONFIGURE_OPTS:-} --with-openssl-dir=$openssl_prefix --with-libyaml-dir=$libyaml_prefix" \
        rbenv install -s "$REQUIRED_RUBY_VERSION" && rbenv global "$REQUIRED_RUBY_VERSION"
      ;;
    freebsd* | linux*)
      if ! type -p rbenv >/dev/null; then get-rbenv; fi
      rbenv install $REQUIRED_RUBY_VERSION
      rbenv rehash
      rbenv global $REQUIRED_RUBY_VERSION
      ;;
  esac
}

get-global-gem-packages() {
  gem install \
    benchmark-ips \
    bundler \
    compass \
    git-trend \
    haml \
    html2slim \
    peek-rblineprof \
    rack-lineprof \
    rails \
    rblineprof \
    rubygems-bundler \
    serverspec \
    sidekiq \
    slim \
    stackprof \
    unicorn
  gem install rufo -v 0.1.0
}

if [[ $OSTYPE == darwin* && $RUBY_PACKAGE_MANAGER == anyenv && "$(command -v ruby)" == /usr/bin/ruby ]]; then
  get-ruby-by-anyenv
fi

case ${RUBY_PACKAGE_MANAGER} in
  rbenv)
    if (
      ! type -p ruby >/dev/null &&
        [[ $(rbenv versions | awk '{print $1$2}') == "*system" ]]
    ); then
      get-ruby
    fi
    ;;
esac

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
