#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-os-update]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

update-ubuntu-from-12.04-to-14.04() {
  case $OSTYPE in
    linux*)
      case "${DIST}" in
        Ubuntu)
          sudo apt-get update
          sudo apt-get upgrade
          sudo apt-get dist-upgrade
          sudo apt-get install update-manager-core
          sudo do-release-upgrade
          ;;
      esac
      ;;
  esac
}

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
