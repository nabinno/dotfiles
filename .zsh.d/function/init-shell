#!/usr/bin/env zsh
if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  print
  print -r -- '[init-shell]'
fi
zmodload zsh/datetime
local -F _start_time=$EPOCHREALTIME

get-shellcheck() {
  case $OSTYPE in
    linux*)
      case $DIST in
        Ubuntu) sudo apt-get install shellcheck ;;
      esac
      ;;
  esac
}

get-shfmt() {
  case $OSTYPE in
    linux*)
      (
        cd $(mktemp -d)
        go mod init tmp
        go get mvdan.cc/sh/cmd/shfmt
      )
      ;;
  esac
}
if ! type -p shfmt >/dev/null; then get-shfmt; fi

if [[ ${ZSH_INIT_VERBOSE:-0} == 1 ]]; then
  printf "time: %.3f sec\n" "$(( EPOCHREALTIME - _start_time ))"
fi
